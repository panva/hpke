{
  "include": ["api.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": { "hpke": ["../index.d.ts"] },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
